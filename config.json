{
  "_readme": "LLM settings: any OpenAI-compatible API works. Default is DeepSeek (cheap, excellent Chinese). Set your key via the env var named in api_key_env (e.g. `setx DEEPSEEK_API_KEY sk-xxx`) or paste it directly into llm.api_key. For OpenAI use base_url https://api.openai.com/v1 and model gpt-4o-mini. feeds[].keywords=true means the feed is general-tech and only AI-related stories are kept.",

  "llm": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "api_key": "",
    "temperature": 0.3,
    "max_tokens": 600,
    "timeout_seconds": 120,
    "concurrency": 4
  },

  "news": {
    "hours_back": 24,
    "max_articles": 20,
    "min_importance": 2,
    "request_timeout": 30
  },

  "report": {
    "reports_dir": "reports",
    "top_cap": 5,
    "save_json": true
  },

  "feeds": [
    { "name": "OpenAI",              "url": "https://openai.com/news/rss.xml",                           "lang": "en" },
    { "name": "Google AI",           "url": "https://blog.google/technology/ai/rss/",                   "lang": "en" },
    { "name": "Google DeepMind",     "url": "https://deepmind.google/blog/rss.xml",                     "lang": "en" },
    { "name": "MIT Technology Review","url": "https://www.technologyreview.com/topic/artificial-intelligence/feed", "lang": "en" },
    { "name": "VentureBeat",         "url": "https://venturebeat.com/category/ai/feed/",                "lang": "en" },
    { "name": "The Verge",           "url": "https://www.theverge.com/rss/ai-artificial-intelligence/index.xml", "lang": "en" },
    { "name": "TechCrunch",          "url": "https://techcrunch.com/category/artificial-intelligence/feed/", "lang": "en" },
    { "name": "The Guardian",        "url": "https://www.theguardian.com/technology/artificialintelligenceai/rss", "lang": "en", "keywords": true },
    { "name": "MarkTechPost",        "url": "https://www.marktechpost.com/feed/",                       "lang": "en" },
    { "name": "Ars Technica",        "url": "https://feeds.arstechnica.com/arstechnica/technology-lab", "lang": "en", "keywords": true },
    { "name": "BBC Tech",            "url": "https://feeds.bbci.co.uk/news/technology/rss.xml",         "lang": "en", "keywords": true },
    { "name": "CNBC Tech",           "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=19854910", "lang": "en", "keywords": true },
    { "name": "量子位 QbitAI",       "url": "https://www.qbitai.com/feed",                              "lang": "zh" },
    { "name": "雷锋网 Leiphone",     "url": "https://www.leiphone.com/feed",                            "lang": "zh", "keywords": true },
    { "name": "InfoQ 中文",          "url": "https://www.infoq.cn/feed",                                "lang": "zh", "keywords": true },
    { "name": "爱范儿 ifanr",        "url": "https://www.ifanr.com/feed",                               "lang": "zh", "keywords": true }
  ]
}
